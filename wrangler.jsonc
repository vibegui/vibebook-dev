{
  // Its own Worker: the old app Worker "vibebook" keeps its Durable Objects (the data written after the copy) untouched.
  "name": "vibebook-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Parking site: every request goes through the worker so HTML pages get the "now deco.chat" banner.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  // The old app Worker, kept for its data; only /migrate/* is forwarded to it (remove once the copy is done).
  "services": [{ "binding": "OLD", "service": "vibebook" }],
  "routes": [{ "pattern": "vibebook.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
